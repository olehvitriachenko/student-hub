{
  "expo": {
    "name": "Student Hub",
    "slug": "student-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ua.edu.knute.studenthub"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ua.edu.knute.studenthub"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "color": "#FF6B3D"
        }
      ]
    ],
    "scheme": "studenthub",
    "experiments": {
      "typedRoutes": false
    }
  }
}
